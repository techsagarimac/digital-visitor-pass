# Copy this file to .env and fill in values as needed.
# Email is optional. Leave SMTP fields empty to disable notifications.

SECRET_KEY=change-this-to-a-random-string
ORGANIZATION_NAME=Apex Institute of Technology
BASE_URL=http://127.0.0.1:5000

# Demo admin (change before any real deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional SMTP — leave blank to skip emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=

# Optional OpenAI key for purpose classification (keyword fallback if empty)
OPENAI_API_KEY=
